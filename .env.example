# AI chat ("Ask the cat"). Copy to .env.local for `npm run dev`, or add these in Vercel →
# Project → Settings → Environment Variables. Set ONE key; the first one set wins, in this order.
# Never commit a real key.

# Claude (Anthropic): paid, very cheap (Claude Haiku 5.5). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini: free tier. Get a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=

# Groq: free plan. https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=
